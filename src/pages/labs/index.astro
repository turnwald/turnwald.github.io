---
import Layout from '../../layouts/Layout.astro';
import { labs } from '../../data/labs.js';
---
<Layout title="Interactive labs"><section class="page-intro shell"><h1>Interactive labs</h1><p>Browser-based demonstrations and learning applications.</p></section><section class="shell page-content">{labs.length ? <div class="listing">{labs.map(lab => <a class="list-card" href={lab.url}><div><h2>{lab.title}</h2><p>{lab.description}</p><span class="tag">{lab.kind}</span></div></a>)}</div> : <div class="empty"><h2>No labs listed yet</h2><p>Interactive demonstrations will appear here when available.</p></div>}</section></Layout>