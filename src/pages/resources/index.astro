---
import Layout from '../../layouts/Layout.astro';
import { resources } from '../../data/resources.js';
---
<Layout title="Open-source resources"><section class="page-intro shell"><h1>Open-source resources</h1><p>Public teaching repositories, software and templates. Each link opens the independent GitHub project.</p></section><section class="shell page-content"><div class="listing">{resources.map(resource => <a class="list-card" href={resource.url}><div><h2>{resource.title}</h2><p>{resource.description}</p><span class="tag">{resource.tag}</span></div></a>)}</div></section></Layout>