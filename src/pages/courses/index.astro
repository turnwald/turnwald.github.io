---
import Layout from '../../layouts/Layout.astro';
import { courses } from '../../data/courses.js';
---
<Layout title="Courses"><section class="page-intro shell"><h1>Courses</h1><p>Teaching modules and resources in robotics, control and autonomous systems.</p></section><section class="shell page-content">{courses.length ? <div class="listing">{courses.map(course => <a class="list-card" href={`/courses/${course.slug}/`}><div><h2>{course.title}</h2><p>{course.description}</p></div></a>)}</div> : <div class="empty"><h2>No courses listed yet</h2><p>Course descriptions and teaching resources will appear here when available.</p></div>}</section></Layout>