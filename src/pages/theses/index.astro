---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { thesisHistory, unavailableIds } from '../../data/thesis-history.js';
const topics = (await getCollection('theses')).filter(topic => !unavailableIds.has(topic.data.topicId)).sort((a, b) => a.data.topicId.localeCompare(b.data.topicId));
const areas = [...new Set(topics.map(topic => topic.data.area))].sort();
const groups = ['In progress', 'Completed'].map(status => ({ status, records: thesisHistory.filter(record => record.status === status).sort((a,b) => a.id.localeCompare(b.id)) }));
---
<Layout title="Thesis opportunities"><section class="page-intro shell"><h1>Theses</h1><p>Open thesis opportunities and an overview of ongoing and completed projects.</p></section><section class="shell page-content"><h2>Available opportunities</h2>{topics.length ? <><div class="filters"><label>Level <select id="level-filter"><option value="">All levels</option><option>Bachelor</option><option>Master</option></select></label><label>Research area <select id="area-filter"><option value="">All areas</option>{areas.map(area => <option>{area}</option>)}</select></label></div><div class="listing" id="topics">{topics.map(topic => <a class="list-card topic" href={`/theses/${topic.id}/`} data-levels={topic.data.levels.join(',')} data-area={topic.data.area}><div><h2>{topic.data.topicId}: {topic.data.title}</h2><p>{topic.data.summary}</p><span class="tag">{topic.data.levelNote} · {topic.data.area} · {topic.data.category}</span><p>{topic.data.availabilityNote}</p></div></a>)}</div><p id="no-results" hidden>No topics match these filters.</p></> : <div class="empty"><p>No public opportunities are currently listed.</p></div>}{groups.map(group => <section class="history-group"><h2>{group.status}</h2>{group.records.length ? <div class="listing">{group.records.map(record => <article class="history-item"><h3>{record.title}</h3><p>{[record.id, record.level, record.area, record.year, record.status].filter(Boolean).join(' · ')}</p></article>)}</div> : <p class="history-empty">No public records listed.</p>}</section>)}<p class="related">Looking for a template? <a href="https://github.com/turnwald/thesis-template">View the thesis template on GitHub</a>.</p></section><script>const level = document.querySelector('#level-filter'); const area = document.querySelector('#area-filter'); const cards = [...document.querySelectorAll('.topic')]; function filter() { let count = 0; cards.forEach(card => { const show = (!level.value || card.dataset.levels.split(',').includes(level.value)) && (!area.value || card.dataset.area === area.value); card.hidden = !show; if (show) count++; }); document.querySelector('#no-results').hidden = count > 0; } level?.addEventListener('change', filter); area?.addEventListener('change', filter);</script></Layout>