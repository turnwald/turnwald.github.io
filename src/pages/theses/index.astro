---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const topics = await getCollection('theses');
const areas = [...new Set(topics.map(topic => topic.data.area))].sort();
---
<Layout title="Thesis opportunities"><section class="page-intro shell"><div class="eyebrow muted">03 / INVESTIGATE</div><h1>Thesis opportunities<span class="accent">.</span></h1><p>Public bachelor’s and master’s thesis topics in robotics, control and autonomous systems.</p></section><section class="shell page-content">{topics.length ? <><div class="filters"><label>Level <select id="level-filter"><option value="">All levels</option><option>Bachelor</option><option>Master</option></select></label><label>Research area <select id="area-filter"><option value="">All areas</option>{areas.map(area => <option>{area}</option>)}</select></label></div><div class="listing" id="topics">{topics.map(topic => <a class="list-card topic" href={`/theses/${topic.id}/`} data-level={topic.data.level} data-area={topic.data.area}><div><span class="tag">{topic.data.level} / {topic.data.area} / {topic.data.status}</span><h2>{topic.data.title}</h2><p>{topic.data.summary}</p></div><span class="arrow">↗</span></a>)}</div><p id="no-results" hidden>No topics match these filters.</p></> : <div class="empty"><span class="empty-symbol">○</span><h2>No public topics at the moment.</h2><p>Approved thesis announcements will be published here when available.</p></div>}</section><script>const level = document.querySelector('#level-filter'); const area = document.querySelector('#area-filter'); const cards = [...document.querySelectorAll('.topic')]; function filter() { let count = 0; cards.forEach(card => { const show = (!level.value || card.dataset.level === level.value) && (!area.value || card.dataset.area === area.value); card.hidden = !show; if (show) count++; }); document.querySelector('#no-results').hidden = count > 0; } level?.addEventListener('change', filter); area?.addEventListener('change', filter);</script></Layout>
