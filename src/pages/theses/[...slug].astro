---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { unavailableIds } from '../../data/thesis-history.js';
export async function getStaticPaths() { return (await getCollection('theses')).filter(topic => !unavailableIds.has(topic.data.topicId)).map(topic => ({ params: { slug: topic.id }, props: { topic } })); }
const { topic } = Astro.props;
const { Content } = await render(topic);
---
<Layout title={`${topic.data.topicId}: ${topic.data.title}`}><section class="page-intro shell"><a class="back" href="/theses/">← All thesis opportunities</a><div class="tag">{topic.data.levelNote} · {topic.data.area} · {topic.data.category}</div><h1>{topic.data.topicId}: {topic.data.title}</h1><p><strong>Availability:</strong> {topic.data.availabilityNote}</p></section><article class="shell page-content prose"><Content /></article></Layout>