---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('theses')).map(topic => ({ params: { slug: topic.id }, props: { topic } })); }
const { topic } = Astro.props;
const { Content } = await render(topic);
---
<Layout title={topic.data.title}><section class="page-intro shell"><a class="back" href="/theses/">← All thesis opportunities</a><div class="tag">{topic.data.level} / {topic.data.area} / {topic.data.status}</div><h1>{topic.data.title}</h1><p>{topic.data.summary}</p></section><article class="shell page-content prose"><Content /></article></Layout>
